# =============================================================================
# AttritionIQ - Environment Configuration Template
# =============================================================================
# Copy this file to backend/.env and customize values for your deployment.
# NEVER commit your actual .env file or production secrets to version control.

# Application Settings
APP_NAME="Employee Attrition Risk Intelligence System"
DEBUG=false

# Authentication & Security (Generate a strong random secret for production)
SECRET_KEY=your-super-secret-jwt-key-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=120

# Database Configuration (Defaults to SQLite for local development)
DATABASE_URL=sqlite+aiosqlite:///./attrition.db

# Machine Learning Pipeline Configuration
MODEL_VERSION=v1
MODEL_ARTIFACT_PATH=app/ml/artifacts/model_v1.pkl
FEATURE_NAMES_PATH=app/ml/artifacts/feature_names.json

# Attrition Risk Threshold Boundaries
LOW_THRESHOLD=0.30
HIGH_THRESHOLD=0.60

# Google Gemini Generative AI Assistant Configuration
# Obtain an API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-1.5-flash

# CORS Allowed Origins (Comma-separated URLs for frontend clients)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
